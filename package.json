{
  "name": "dsh-personal-workbench",
  "version": "0.4.0",
  "description": "Personal workbench for DeepSeek Harness",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "dist/client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "THIRD_PARTY.md",
    "skills"
  ],
  "engines": {
    "dsh": "0.2.2-rc.5 || 0.2.3-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-session-status",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.4.3",
    "tailwind-merge": "3.3.1",
    "lucide-react": "0.468.0",
    "@tailwindcss/cli": "4.1.18",
    "tailwindcss": "4.1.18",
    "postcss": "8.5.6",
    "postcss-selector-parser": "7.1.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/node": "22.19.1",
    "sucrase": "3.35.1"
  },
  "packageManager": "pnpm@10.11.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoName4Me/dsh-personal-workbench.git"
  },
  "homepage": "https://github.com/NoName4Me/dsh-personal-workbench#readme",
  "bugs": {
    "url": "https://github.com/NoName4Me/dsh-personal-workbench/issues"
  }
}
